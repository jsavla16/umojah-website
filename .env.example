# Template for the environment variables the contact form needs.
# This file IS committed — it documents the shape without holding secrets.
# Copy to .env.local and fill in, or set the same values in Vercel.

# --- RESEND_API_KEY is deliberately NOT in this file ------------------
# It lives in the shell environment instead, not in the project folder:
#
#   echo 'export RESEND_API_KEY="re_..."' >> ~/.zshrc
#   source ~/.zshrc
#
# Next.js reads it through process.env exactly the same way. Real shell
# variables take precedence over .env files, so there is nothing to
# configure — the API route needs no change.
#
# WHY: anything inside the project folder gets read by editors, backup
# tools, screen shares and AI assistants. A key that never enters the
# folder can't leak from it. Vercel supplies its own copy in production,
# so this only affects local development.
#
# GOTCHA: apps launched from the Dock or Spotlight don't always source
# ~/.zshrc. If the form starts reporting "not configured", start the dev
# server from a normal Terminal window.

# --- Not secrets, so these stay in .env.local -------------------------

# Where enquiries land. Comma-separate for several recipients.
CONTACT_TO="you@example.com, someone-else@example.com"

# Sender. Must be on a domain verified at https://resend.com/domains,
# or use onboarding@resend.dev for testing (delivers only to the address
# your Resend account was registered with).
CONTACT_FROM="Umojah Website <bookings@example.com>"

# --- Umojah Records mailing list --------------------------------------
# Create an Audience at https://resend.com/audiences and paste its ID.
# Not a secret, so this one can live in .env.local (and must also be set
# in Vercel, followed by a redeploy).
UMOJAH_RECORDS_AUDIENCE_ID=""
