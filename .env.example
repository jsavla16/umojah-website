# Template for the environment variables the contact form needs.
# This file IS committed — it documents the shape without holding secrets.
# Copy to .env.local and fill in, or set the same three in Vercel.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries land. Comma-separate for several recipients.
CONTACT_TO="you@example.com, someone-else@example.com"

# Sender. Must be on a domain verified at https://resend.com/domains,
# or use onboarding@resend.dev for testing (delivers only to the address
# your Resend account was registered with).
CONTACT_FROM="Umojah Website <bookings@example.com>"
